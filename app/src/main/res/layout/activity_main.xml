<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_main"
        app:navigationIcon="@drawable/ic_npu_chip"
        app:title="@string/app_name" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Компактная панель статуса Hexagon NPU, выбранной GGUF-модели, токенов и потребления ОЗУ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNpuStatus"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNpuBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Проверка Qualcomm Hexagon NPU…"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="@string/label_no_model_loaded"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectGgufHeader"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/action_select_gguf"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_folder_open"
                    app:iconSize="16dp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressModelLoad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:visibility="gone"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/tvLoadProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressContextUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                app:trackCornerRadius="3dp"
                app:trackThickness="4dp" />

            <TextView
                android:id="@+id/tvTokenStatsLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Токены контекста: 0 / 4096 (0%) • Промпт: 0 • Ответ: 0"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <TextView
                android:id="@+id/tvRamStatsLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ОЗУ процесса: -- МБ • Свободно ОЗУ: -- ГБ"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Баннер блокировки, если устройство не оснащено Qualcomm Hexagon NPU -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNpuBlockedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/npu_error_container"
        app:cardCornerRadius="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvNpuBlockedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/npu_on_error_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryNpuInit"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="36dp"
                android:text="@string/action_retry_npu"
                android:textColor="@color/npu_on_error_container" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- Центральная область: либо пустое состояние, либо лента сообщений чата -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_npu_chip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/empty_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickModelEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_select_gguf"
                    app:icon="@drawable/ic_folder_open" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSettingsEmpty"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/action_model_settings"
                    app:icon="@drawable/ic_tune" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Нижняя панель ввода и быстрого сброса чата -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDraftTokens"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="История чата не сохраняется"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearChatQuick"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:paddingHorizontal="8dp"
                android:text="@string/action_clear_chat"
                android:textSize="12sp"
                android:visibility="gone"
                app:icon="@drawable/ic_delete_sweep"
                app:iconSize="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPromptInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_chat_input"
                    android:imeOptions="actionSend|flagNoPersonalizedLearning"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minLines="1"
                    android:paddingVertical="10dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendOrStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/action_send" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/apiPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/tvApiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API остановлен" />
            <TextView
                android:id="@+id/tvApiToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textIsSelectable="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Доступ только с этого устройства. Не передавайте Bearer token посторонним. POST /v1/chat/completions, GET /v1/models. Потоковый ответ не поддерживается." />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApiStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Запустить API" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApiStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Остановить API" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/imagePanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Модели занимают более 1 ГБ каждая. Условия OpenRAIL распространяются на модель. DreamShaper для 8 Gen 2 может не загрузиться на 8s Gen 3. Перед генерацией выгрузите модель чата. Anything V5: CLIP на CPU, UNet/VAE — попытка на NPU без CPU fallback; графы для CPU могут не загрузиться на NPU."
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <Spinner
                android:id="@+id/spinnerImageModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="Модель изображения" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImageDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Скачать выбранную модель" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImageDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удалить выбранную модель" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImageImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Импортировать папку модели" />
            <TextView
                android:id="@+id/tvImageStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Описание изображения">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImagePrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Шаги (LCM 1–50, SD 1–100)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImageSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="4" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/negativePromptLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Негативное описание (Anything V5)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNegativePrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="1" android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/guidanceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CFG (Anything V5: 1–20)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImageGuidance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="7.5" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Seed (пусто — случайный)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImageSeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImageGenerate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Создать" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImageCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Отмена" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImageSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PNG" />
            </LinearLayout>
            <ImageView
                android:id="@+id/ivGeneratedImage"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:contentDescription="Сгенерированное изображение"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
